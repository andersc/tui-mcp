{
  "name": "tui-mcp",
  "version": "1.2.2",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "tui-mcp": "src/server.js"
  },
  "files": [
    "src",
    "dist",
    "build.js"
  ],
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test 'test/*.test.js'",
    "build": "node build.js",
    "prepublishOnly": "npm run build",
    "postinstall": "node -e \"const fs=require('fs'),path=require('path');try{const p=path.join(path.dirname(require.resolve('node-pty/package.json')),'prebuilds');for(const d of fs.readdirSync(p)){try{fs.chmodSync(path.join(p,d,'spawn-helper'),0o755)}catch{}}}catch{}\""
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "MCP server for observing and interacting with TUI applications",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@xterm/headless": "^5.5.0",
    "canvas": "^3.1.0",
    "node-pty": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@trendr/core": "^0.2.2",
    "esbuild": "^0.27.4"
  }
}
